# ==============================================================================
# LLM Provider Configuration (100% Free Tiers Supported)
# ==============================================================================
# Supported providers: "groq", "gemini", "openrouter", "github", "openai", "mock"
# Default is "mock" (offline testing without any API key).

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# HOW TO GET A 100% FREE API KEY (NO CREDIT CARD REQUIRED):
# ------------------------------------------------------------------------------
# Option 1: Groq Cloud (Recommended - Ultra-fast 300+ tok/s, 70B parameter model)
#   - Sign up at: https://console.groq.com/keys
#   - Generate a free API key (starts with "gsk_...")
#   - Set:
#     LLM_PROVIDER=groq
#     GROQ_API_KEY=gsk_your_key_here
#     LLM_MODEL=llama-3.3-70b-versatile
#
# Option 2: Google Gemini API (Free 15 RPM, 1,500 req/day, strong Indic support)
#   - Sign up at: https://aistudio.google.com/app/apikey
#   - Generate a free API key (starts with "AIza...")
#   - Set:
#     LLM_PROVIDER=gemini
#     GEMINI_API_KEY=AIza_your_key_here
#     LLM_MODEL=gemini-1.5-flash
#
# Option 3: OpenRouter Free Models
#   - Sign up at: https://openrouter.ai/keys
#   - Set:
#     LLM_PROVIDER=openrouter
#     OPENROUTER_API_KEY=sk-or-v1-...
#     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Option 4: GitHub Models (Free with GitHub account)
#   - Generate personal access token at: https://github.com/settings/tokens
#   - Set:
#     LLM_PROVIDER=github
#     GITHUB_TOKEN=ghp_...
#     LLM_MODEL=gpt-4o-mini
# ------------------------------------------------------------------------------
